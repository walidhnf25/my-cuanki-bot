# ============================================================
# finance-whatsapp-bot (Cuanki) — Environment Variables (EXAMPLE)
# Copy to .env.development / .env.production and fill values.
# On Vercel, set these in Project Settings > Environment Variables.
# NEVER commit real .env files.
# ============================================================

# --- App ---
NODE_ENV=development
PORT=3000
APP_NAME=finance-whatsapp-bot

# --- Logging (Pino) ---
# levels: fatal | error | warn | info | debug | trace
LOG_LEVEL=debug
# pretty print logs in dev (true), JSON in prod (false)
LOG_PRETTY=true

# --- Google Sheets (database) ---
# Spreadsheet id from https://docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=
# Service account (share the spreadsheet with this email as Editor)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# private_key from the service-account JSON; literal \n sequences are fine
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Parser abstraction ---
# rule (MVP). future: openai | gemini | ollama
PARSER_DRIVER=rule

# --- Telegram ---
# token from @BotFather
TELEGRAM_BOT_TOKEN=
# random string; pass the same value as secret_token to setWebhook
TELEGRAM_WEBHOOK_SECRET=
# true = long-poll getUpdates (local dev only, never on Vercel)
TELEGRAM_POLLING=true
# optional comma-separated Telegram user ids allowed to use the bot (empty = anyone)
TELEGRAM_ALLOWED_USER_IDS=

# --- Swagger (local server only) ---
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
