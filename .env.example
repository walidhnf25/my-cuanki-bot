# ============================================================
# finance-whatsapp-bot — Environment Variables (EXAMPLE)
# Copy to .env.development / .env.production and fill values.
# NEVER commit real .env files.
# ============================================================

# --- App ---
NODE_ENV=development
PORT=3000
APP_NAME=finance-whatsapp-bot
TZ=Asia/Jakarta

# --- Logging (Pino) ---
# levels: fatal | error | warn | info | debug | trace
LOG_LEVEL=debug
# pretty print logs in dev (true), JSON in prod (false)
LOG_PRETTY=true

# --- Database (PostgreSQL) ---
# For local (host) dev use localhost; inside docker-compose use host "postgres".
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance_secret_change_me
POSTGRES_DB=finance_bot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://finance:finance_secret_change_me@localhost:5432/finance_bot?schema=public

# --- Parser abstraction ---
# rule (MVP). future: openai | gemini | ollama
PARSER_DRIVER=rule

# --- WhatsApp / Baileys ---
# folder to persist auth session (mounted volume in docker)
WA_SESSION_PATH=./storage/wa-session
# print QR to terminal on first login
WA_PRINT_QR=true
# connect to WhatsApp on boot (set false in tests/CI)
WA_AUTOSTART=true

# --- Swagger ---
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
